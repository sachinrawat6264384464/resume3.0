rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Candidate resumes storage
    match /resumes/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Interview video/audio recordings storage
    match /recordings/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Public asset access
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
