# CloudOps AI Assessment Platform - Backend Environment Configuration

PROJECT_NAME="CloudOps AI Assessment Platform"
ENVIRONMENT="development"
DEBUG=true

# Database (Default is local SQLite, replace with Neon Postgres URL for production)
DATABASE_URL="sqlite+aiosqlite:///./cloudops_interview.db"
# Example Neon PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://user:password@ep-sparkling-pool-123456.us-east-2.aws.neon.tech/cloudops_db?ssl=require"

# JWT & Authentication
SECRET_KEY="replace-with-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
MOCK_AUTH_ENABLED=true

# Firebase Authentication (Optional in dev, required in production)
FIREBASE_PROJECT_ID="cloudops-interview"
FIREBASE_CREDENTIALS_PATH=""

# AI LLM Provider ("mock", "ollama", "openai")
AI_PROVIDER="mock"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3:latest"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Speech-to-Text Provider ("mock", "whisper")
STT_PROVIDER="mock"

# Storage Provider ("local", "google_drive")
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./storage/recordings"
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=""

# Retention Policy
RECORDING_RETENTION_DAYS=90
DEFAULT_PASSING_SCORE=80.0

# CORS Origins Configuration for Vercel Live Deployment
BACKEND_CORS_ORIGINS='["https://resume3-0.vercel.app", "https://resume3-admin.vercel.app", "http://localhost:3000", "http://localhost:3001", "*"]'

